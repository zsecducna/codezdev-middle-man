:{$PORT:8080} {
    # Match allowed client origins
    @cors_origins {
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
    }

    # Match preflight OPTIONS requests from allowed origins
    @cors_preflight {
        method OPTIONS
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
    }

    # Attach CORS headers to responses for allowed origins
    header @cors_origins {
        Access-Control-Allow-Origin "{header.Origin}"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, Accept, X-Requested-With"
        Access-Control-Max-Age "86400"
        Vary "Origin"
    }

    # Answer OPTIONS preflight immediately with 204 No Content
    respond @cors_preflight 204

    # Match allowed API endpoints
    @allowed {
        path /api /api/* /v1 /v1/* /img /img/* /videos /video /videos/* /video/*
    }

    # Forward matching API endpoints to llmgate
    handle @allowed {
        reverse_proxy https://llmgate.app {
            header_up Host llmgate.app
            header_up X-Real-IP {remote_host}
            flush_interval -1
            transport http {
                response_header_timeout 3600s
                dial_timeout 30s
            }
        }
    }

    # Reject everything else
    handle {
        respond "Not Found" 404
    }
}