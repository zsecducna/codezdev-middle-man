:{$PORT:8080} {
    reverse_proxy https://llmgate.app {
        header_up Host llmgate.app
        header_up X-Real-IP {remote_host}

        # Disable response buffering for Server-Sent Events (SSE) / streaming
        flush_interval -1

        # Match Cloud Run's extended response timeout (60m)
        transport http {
            response_header_timeout 3600s
            dial_timeout 30s
        }
    }
}