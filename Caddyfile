{
    # Tell Caddy when to execute response replacement
    order replace after encode
}

:{$PORT:8080} {
    # Match allowed client origins for CORS
    @cors_origins {
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
    }

    @cors_preflight {
        method OPTIONS
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
    }

    header @cors_origins {
        Access-Control-Allow-Origin "{header.Origin}"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, Accept, X-Requested-With"
        Access-Control-Max-Age "86400"
        Vary "Origin"
    }

    respond @cors_preflight 204

    # Match allowed API & media endpoints
    @allowed {
        path /api /api/* /v1 /v1/* /img /img/* /videos /video /videos/* /video/*
    }

    handle @allowed {
        # Replace target domain in response body
        replace stream {
            "llmgate.app" "api.codezdev-shop.uk"
        }

        reverse_proxy https://llmgate.app {
            header_up Host llmgate.app

            # Disable upstream gzip so Caddy can find & replace text strings
            header_up Accept-Encoding identity

            # Rewrite upstream domain in response headers (e.g. redirect URLs)
            header_down Location "llmgate.app" "api.codezdev-shop.uk"

            flush_interval -1
            transport http {
                response_header_timeout 3600s
                dial_timeout 30s
                keep_alive {
                    enabled true
                    max_idle_conns 100
                    max_idle_conns_per_host 64
                    idle_timeout 90s
                }
            }
        }
    }

    # Reject everything else
    handle {
        respond "Not Found" 404
    }
}