:{$PORT:8080} {
    # Match /api, /api/*, /v1, and /v1/*
    @allowed {
        path /api /api/* /v1 /v1/*
    }

    # Forward matching paths to llmgate
    handle @allowed {
        reverse_proxy https://llmgate.app {
            header_up Host llmgate.app
            header_up X-Real-IP {remote_host}
            flush_interval -1
            transport http {
                response_header_timeout 3600s
                dial_timeout 30s
            }
        }
    }

    # Reject everything else with a 404 Not Found
    handle {
        respond "Not Found" 404
    }
}