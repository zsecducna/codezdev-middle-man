
{
    # Register the replace-response plugin's directive.
    order replace after encode

    # Allow time for load balancer draining before shutdown begins.
    shutdown_delay 30s

    # Wait up to 60 seconds for active requests to finish.
    grace_period 60s
}

:{$PORT:8080} {
    # Allow requests from these client origins.
    @cors_origins {
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
    }

    # Match preflight requests for allowed origins and paths.
    @cors_preflight {
        method OPTIONS
        header Origin https://codezdev-shop.uk
        header Origin https://dev.codezdev-shop.uk
        path /api /api/* /v1 /v1/* /img /img/* /videos /video /videos/* /video/*
    }

    # CORS response headers.
    header @cors_origins {
        Access-Control-Allow-Origin {header.Origin}
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, Accept, X-Requested-With"
        Access-Control-Max-Age "86400"
        +Vary Origin
        defer
    }

    # Respond to valid preflight requests without contacting upstream.
    handle @cors_preflight {
        respond 204
    }

    # Only proxy requests to the approved endpoint paths.
    @allowed {
        path /api /api/* /v1 /v1/* /img /img/* /videos /video /videos/* /video/*
    }

    handle @allowed {
        # Replace upstream domain references in response bodies.
        replace stream {
            "llmgate.app" "api.codezdev-shop.uk"
        }

        reverse_proxy https://llmgate.app {
            # Allow upgraded streams to remain open during config reloads.
            stream_close_delay 60s

            # Set the upstream host.
            header_up Host llmgate.app

            # Request uncompressed responses for body replacement.
            header_up Accept-Encoding identity

            # Rewrite upstream redirect URLs.
            header_down Location "llmgate[.]app" "api.codezdev-shop.uk"

            # Improve latency for streaming responses.
            flush_interval -1

            transport http {
                dial_timeout 30s
                response_header_timeout 3600s

                keepalive 90s
                keepalive_idle_conns 100
                keepalive_idle_conns_per_host 64
            }
        }
    }

    # Reject all other paths.
    handle {
        respond "Not Found" 404
    }
}
